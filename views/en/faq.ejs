<%- include('partials/header', { title: 'Frequently asked questions - Location YBMTL' }) %>

<div class="container conditions-page">
  <a class="back-link" href="/en">&larr; Back to home</a>

  <div class="conditions-content faq-content">
    <h1>Frequently asked questions</h1>
    <p>Answers to the questions we are asked most often. Can't find yours? Contact us, we'll be happy to help.</p>

    <div class="faq-list">
      <% faq.forEach(function (item, i) { %>
        <details class="faq-item"<%= i === 0 ? ' open' : '' %>>
          <summary><%= item.q %></summary>
          <div class="faq-answer"><%- item.r %></div>
        </details>
      <% }); %>
    </div>

    <div class="conditions-contact">
      <h2>Another question?</h2>
      <p>
        <strong>Phone:</strong> <a href="tel:<%= company.phone.replace(/[^0-9+]/g,'') %>"><%= company.phone %></a><br>
        <strong>Email:</strong> <a href="mailto:<%= company.email %>"><%= company.email %></a>
      </p>
      <a href="/en#vehicles" class="btn btn-primary" style="margin-top: 1rem;">See the inventory</a>
    </div>
  </div>
</div>

<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en-CA',
  mainEntity: faq.map(function (item) {
    return { '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.r.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&ldquo;|&rdquo;/g, '"') } };
  })
}).replace(/</g, '\\u003c') %>
</script>

<%- include('partials/footer') %>
