<article class="vehicle-card">
  <a class="card-photo" href="/en/vehicle/<%= v.id %>">
    <img src="<%= v.photo ? '/uploads/' + v.photo : '/img/placeholder-car.svg' %>"
         <% if (v.photo && photoSrcset(v.photo)) { %>srcset="<%= photoSrcset(v.photo) %>" sizes="(max-width: 700px) 100vw, 400px"<% } %>
         alt="<%= v.make %> <%= v.model %>" loading="lazy" decoding="async">
    <% if (v.coming_soon) { %>
      <span class="badge badge-soon">🕒 Coming soon</span>
    <% } else if (v.rentedToday) { %>
      <span class="badge badge-rented">Currently rented</span>
    <% } else { %>
      <span class="badge badge-available">Available</span>
    <% } %>
    <% if (v.is_new) { %>
      <span class="badge badge-new">✨ New</span>
    <% } %>
  </a>
  <div class="card-body">
    <h3 class="card-title"><%= v.make %> <%= v.model %></h3>
    <p class="card-sub"><% if (v.show_year) { %><%= v.year %> &middot; <% } %><%= en.trans(v.transmission) %> &middot; <%= v.doors %> doors</p>
    <% if (v.coming_soon) { %>
    <div class="card-footer">
      <div class="card-soon">
        <strong>Coming soon</strong>
        <span>Rate announced soon</span>
      </div>
      <a class="btn btn-sm" href="/en/vehicle/<%= v.id %>">View details</a>
    </div>
    <% } else { %>
    <div class="card-footer">
      <div class="card-price">
        <span class="price-amount"><%= en.money(v.weekly_rate) %></span>
        <span class="price-unit">/ week</span>
        <span class="price-unit">+ taxes</span>
      </div>
      <div class="card-deposit">💳 Deposit: <%= en.money(v.security_deposit) %></div>
      <a class="btn btn-sm" href="/en/vehicle/<%= v.id %>">View details</a>
    </div>
    <% } %>
  </div>
</article>
