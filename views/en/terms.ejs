      <div class="doc-grid">
        <a class="doc-card" href="/docs/Vehicle-Rental-Agreement-YBMTL-EN.pdf" download>
          <span class="doc-flag">🇬🇧</span>
          <span class="doc-text"><strong>English</strong><small>Courtesy translation · PDF</small></span>
          <span class="doc-dl">Download&nbsp;→</span>
        </a>
        <a class="doc-card" href="/docs/Contrat-Location-YBMTL-FR.pdf" download>
          <span class="doc-flag">🇫🇷</span>
          <span class="doc-text"><strong>Français</strong><small>Official version · PDF</small></span>
          <span class="doc-dl">Télécharger&nbsp;→</span>
        </a>
        <a class="doc-card" href="/docs/Contrato-de-Alquiler-YBMTL-ES.pdf" download>
          <span class="doc-flag">🇪🇸</span>
