    <div class="reviews-actions">
      <a class="btn btn-outline" href="https://g.page/r/CfYRExE5jSAFEAI/review" target="_blank" rel="noopener">⭐ Laissez-nous un avis</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
