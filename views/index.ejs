const avisNote = '5,0';
const avisTotal = 15;
const avis = [
  { nom: 'Amina A.',   texte: "Super expérience ! Service rapide, personnel très gentil et voiture impeccable. Honnêtement, c'est le meilleur service de location de voitures en ville. Je recommande à 100 % à tous ceux qui cherchent une location fiable et sans souci. Vous ne serez pas déçus !" },
  { nom: 'Rafaelle Q.', texte: "Les propriétaires sont très professionnelle, ils sont toujours disponible pour nous aidez et pour répondre à nos questions. Les prix sont très abordable. Compagnie très fiable et honnête. Je recommande à 100%!" },
  { nom: 'Emmanuel C.', texte: "Superbe service, très facile pour louer et récupérer la voiture. Je recommande fortement" },
  { nom: 'Francia S.',  texte: "Excellent service, voiture propre et conforme à la description. Je recommande cette location!" },
  { nom: 'Ahmed I.',    texte: "Service professionnel et efficace. Véhicule propre .Tout s'est déroulé parfaitement. Je reviendrai avec plaisir." },
  { nom: 'Ali M.',      texte: "Voitures ultra fiable , toujours bien entretenu , je recommande" },
  { nom: 'Logan C.',    texte: "Very affordable and good service" },
  { nom: 'Yas',         texte: "Thank you for your service. You have excellent prices, high-quality service, and prices to suit everyone." },
  { nom: 'AG',          texte: "Very good service. and prices are affordable" },
];
%>
<section class="reviews-section" id="avis">
  <div class="container">
    <div class="reviews-head">
      <h2>Ce que nos clients disent</h2>
      <div class="reviews-score">
        <span class="reviews-stars">★★★★★</span>
        <span class="reviews-note"><%= avisNote %></span>
        <span class="reviews-count"><%= avisTotal %> avis Google</span>
      </div>
