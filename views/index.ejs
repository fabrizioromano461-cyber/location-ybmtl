<%- include('partials/header', { title: 'Location YBMTL - Location de véhicules à Montréal' }) %>

<section class="hero">
  <div class="container">
    <h1 class="hero-title">Louez votre prochaine voiture à Montréal</h1>
    <p class="hero-subtitle">Consultez notre inventaire, les tarifs et la disponibilité. Une demande, on s'occupe du reste.</p>

    <form class="search-bar" method="get" action="/#vehicules">
      <div class="search-field">
        <label for="depart">Date de départ</label>
        <input type="date" id="depart" name="depart" value="<%= search.start %>">
      </div>
      <div class="search-field">
        <label for="retour">Date de retour</label>
        <input type="date" id="retour" name="retour" value="<%= search.end %>">
      </div>
      <button type="submit" class="btn btn-primary search-btn">Rechercher</button>
    </form>
    <% if (search.hasSearch) { %>
      <p class="search-info">
        Véhicules disponibles du <strong><%= frDate(search.start) %></strong>
        au <strong><%= frDate(search.end) %></strong>.
        <a href="/#vehicules">Effacer le filtre</a>
      </p>
    <% } %>
  </div>
</section>

<%
// ===== BANNIERE PROMO (page d'accueil) =====
// Pour RETIRER la promo : mettre « promoActive = false » ci-dessous.
// Pour la MODIFIER : changer les valeurs (voiture, ancien prix, nouveau prix).
const promoActive = true;
const promo = { make: 'Volkswagen', model: 'GTI', ancien: 800, nouveau: 600 };
const promoVeh = vehicles.find(function (v) { return v.make === promo.make && v.model === promo.model; });
const promoLien = promoVeh ? '/vehicule/' + promoVeh.id : '/#vehicules';
%>
<% if (promoActive && !search.hasSearch) { %>
<section class="promo-band">
  <a class="container promo-inner" href="<%= promoLien %>">
    <span class="promo-flag">★ Nouveau prix</span>
    <span class="promo-car"><%= promo.make %> <%= promo.model %></span>
    <span class="promo-prices">
      <span class="promo-old"><%= money(promo.ancien) %></span>
      <span class="promo-new"><%= money(promo.nouveau) %><small>/ semaine</small></span>
    </span>
    <span class="promo-save">Économisez <%= money(promo.ancien - promo.nouveau) %></span>
    <span class="promo-cta">Voir ce véhicule &rarr;</span>
  </a>
</section>
<% } %>

<% if (typeof featured !== 'undefined' && featured.length > 0) { %>
<section class="featured-section">
  <div class="container">
    <% featured.forEach(function(v) { %>
      <a class="featured-card" href="/vehicule/<%= v.id %>">
        <div class="featured-photo">
          <img src="<%= v.photo ? '/uploads/' + v.photo : '/img/placeholder-car.svg' %>" alt="<%= v.make %> <%= v.model %>">
          <span class="featured-flag">✨ Nouvel arrivé</span>
        </div>
        <div class="featured-info">
          <span class="featured-eyebrow">Dernière arrivée dans notre inventaire</span>
          <h2 class="featured-title"><%= v.make %> <%= v.model %></h2>
          <p class="featured-sub"><% if (v.show_year) { %><%= v.year %> &middot; <% } %><%= v.transmission %> &middot; <%= v.doors %> portes</p>
          <% if (v.description) { %><p class="featured-desc"><%= v.description.length > 180 ? v.description.slice(0, 180) + '…' : v.description %></p><% } %>
          <div class="featured-meta">
            <span class="featured-price"><%= money(v.weekly_rate) %> <small>/ semaine</small></span>
            <span class="featured-deposit">Dépôt <%= money(v.security_deposit) %></span>
          </div>
          <span class="btn btn-primary featured-btn">Voir ce véhicule &rarr;</span>
        </div>
      </a>
    <% }); %>
  </div>
</section>
<% } %>

<section class="vehicles-section" id="vehicules">
  <div class="container">
    <div class="section-head">
      <h2>Notre inventaire</h2>
      <p><%= vehicles.length %> véhicule<%= vehicles.length > 1 ? 's' : '' %>
        <%= search.hasSearch ? 'disponible' + (vehicles.length > 1 ? 's' : '') + ' pour ces dates' : (typeof filtre !== 'undefined' && filtre.hasFilter ? 'trouvé' + (vehicles.length > 1 ? 's' : '') : 'au total') %></p>
      <% if (typeof filtre !== 'undefined' && filtre.hasFilter) { %>
        <p class="filter-info">
          Filtre :
          <% if (filtre.marque) { %><span class="filter-tag"><%= filtre.marque %></span><% } %>
          <% if (filtre.prixMax) { %><span class="filter-tag">≤ <%= money(filtre.prixMax) %>/sem.</span><% } %>
          <a href="/#vehicules">Effacer</a>
        </p>
      <% } %>
    </div>

    <% if (vehicles.length === 0) { %>
      <div class="empty-state">
        <% if (search.hasSearch) { %>
          <p>Aucun véhicule disponible pour ces dates. Essayez d'autres dates ou <a href="/#vehicules">voyez tout l'inventaire</a>.</p>
        <% } else { %>
          <p>Aucun véhicule pour le moment. Revenez bientôt !</p>
        <% } %>
      </div>
    <% } else { %>
      <div class="vehicle-grid">
        <% vehicles.forEach(function(v) { %>
          <%- include('partials/vehicle-card', { v: v }) %>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<%
